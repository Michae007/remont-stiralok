/* Иконочный шрифт (оставляем для WhatsApp и Telegram, если нужно) */
@font-face {
    font-family: 'bootstrap-icons';
    src: url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/fonts/bootstrap-icons.woff2') format('woff2');
    font-display: swap;
}
.icon { font-family: 'bootstrap-icons'; font-style: normal; font-weight: 400; display: inline-block; }
.icon-whatsapp::before { content: "\f618"; }
.icon-telegram::before { content: "\f5ca"; }
